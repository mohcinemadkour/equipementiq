# EquipmentIQ Environment Variables
# Copy to .env and fill in your actual API keys (never commit .env)

# Claude LLM (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI Embeddings
OPENAI_API_KEY=sk-...

# LangSmith Tracing
LANGCHAIN_API_KEY=ls_...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=equipmentiq

# Streamlit Configuration (for Render deployment)
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_FILEWATCHERTYPE=none
STREAMLIT_LOGGER_LEVEL=info
